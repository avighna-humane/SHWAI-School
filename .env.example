# SHWAI AI intelligence layer
#
# Each *_API_KEYS variable accepts one or more keys separated by commas, semicolons,
# or newlines, e.g. GROQ_API_KEYS=key_one,key_two,key_three
#
# All variables below may be left empty. The app runs fine with none of them set —
# providers with no keys are automatically skipped. Fallback order is fixed at
# Groq -> Firebase -> Gemini -> Cerebras (see src/lib/ai/router.ts).
#
# Do NOT put real keys in this file. Add real values to your local .env file or your
# hosting provider's secrets/environment settings instead.

# Groq (https://console.groq.com)
GROQ_API_KEYS=
GROQ_MODEL=

# Firebase AI Logic (https://firebase.google.com/docs/ai-logic), Gemini Developer API backend.
# Requires the Web API key(s) from your Firebase project plus its Project ID and App ID.
FIREBASE_API_KEYS=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_MODEL=

# Gemini Developer API / Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEYS=
GEMINI_MODEL=

# Cerebras (https://cloud.cerebras.ai)
CEREBRAS_API_KEYS=
CEREBRAS_MODEL=
