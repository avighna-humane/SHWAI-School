# SHWAI environment template — names only; never commit real values.
NODE_ENV=development
APP_VERSION=local
PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL. Production requires TLS and managed backups/PITR.
DATABASE_URL=
SUPABASE_DATABASE_URL=

# Session and request security.
SESSION_SECRET=
SHWAI_INTELLIGENCE_CRON_SECRET=
SHWAI_JOB_RUNNER_SECRET=
TRUSTED_ORIGINS=http://localhost:3000

# Server-side email provider abstraction.
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# Private object storage abstraction; credentials never reach the browser.
STORAGE_PROVIDER=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Server-side AI provider abstraction.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
AI_PRIMARY_PROVIDER=
AI_FALLBACK_PROVIDER=

# SaaS billing provider boundary; provider-hosted checkout only.
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Optional identity and education connectors.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
GOOGLE_CLASSROOM_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_ID=

# Distributed controls and observability.
REDIS_URL=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
